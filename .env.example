# Copy to .env.local and fill in every value. All variables are required;
# the app fails fast at startup (src/lib/env) if any is missing or malformed.

# --- App ---------------------------------------------------------------------
# Public origin of this deployment, no trailing slash. Used to build absolute
# URLs for Supabase auth redirects and Stripe Checkout / Portal return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Local stack: `npm run db:signing-key` once, then `npm run db:start` prints
# the URL and keys. Hosted: Settings > API Keys > "Publishable and secret API
# keys" (the legacy anon/service_role JWTs are accepted for the local stack only).
# Each variable below takes ONE key's value. Edge Functions instead receive every
# key at once through the platform's SUPABASE_PUBLISHABLE_KEYS / SUPABASE_SECRET_KEYS
# JSON objects; when copying from there, take the "default" entry's value, not the
# whole object.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...). Safe for the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Stripe ------------------------------------------------------------------
# Server-only secret key (sk_test_... locally).
STRIPE_SECRET_KEY=
# Signing secret for /api/webhooks/stripe. Locally, `npm run stripe:listen`
# prints a whsec_... value.
STRIPE_WEBHOOK_SECRET=

# --- Bright Data -------------------------------------------------------------
# API key from the Bright Data dashboard (Account settings > API keys).
# Server-only; sent as a Bearer token to api.brightdata.com.
BRIGHTDATA_API_KEY=
# Shared secret for /api/webhooks/brightdata. Any random string of 32+
# characters (for example `openssl rand -hex 32`). Every collection is
# triggered with it as the delivery Authorization header, and the webhook
# route accepts only deliveries that carry it.
BRIGHTDATA_WEBHOOK_SECRET=
